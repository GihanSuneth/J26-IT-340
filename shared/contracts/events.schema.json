{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "JSON Schema of every event exchanged between components (the integration contract). DRAFT: payload fields per event must be agreed by all four members before first integration.",
  "title": "Smart trolley events",
  "$defs": {
    "weight_event": {
      "type": "object",
      "required": [
        "event_id",
        "session_id",
        "timestamp",
        "type",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "const": "weight_event"
        },
        "payload": {
          "type": "object"
        }
      }
    },
