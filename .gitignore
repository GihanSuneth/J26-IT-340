# .gitignore - Files git must never track: secrets, datasets, model weights, caches.
# Owner: develop (shared - all four members review)

.env
*.env
!*.env.example
.DS_Store
__pycache__/
*.pyc
.venv/
node_modules/
dist/
.ipynb_checkpoints/
data/raw/*
!data/raw/README.md
component3/data/raw/*
!component3/data/raw/README.md
data/processed/*
!data/processed/.gitkeep
component3/data/processed/*
!component3/data/processed/.gitkeep
data/datasets/*/*
!data/datasets/*/.gitkeep
!data/datasets/*/README.md
!data/datasets/*/ATTRIBUTION.csv
component3/data/datasets/*/*
!component3/data/datasets/*/.gitkeep
!component3/data/datasets/*/README.md
!component3/data/datasets/*/ATTRIBUTION.csv
ml/models/*
!ml/models/README.md
component3/ml/models/*
!component3/ml/models/comp3/
!component3/ml/models/comp3/.gitkeep
*.pt
*.onnx
*.pkl
.pio/
